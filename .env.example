# Copy this file to `.env` and fill in the real Supabase credentials provided by your project owner.
# The publishable key and URL are required for the app to initialize the Supabase client in
# `src/integrations/supabase/client.ts`.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
BACKEND_PORT="4000"
DAILY_API_KEY=""
DAILY_PROJECT_URL="https://your-team.daily.co"
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_PUBLIC_KEY=""
