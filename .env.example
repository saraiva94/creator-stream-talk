# Copy this file to `.env` and fill in the real Supabase credentials provided by your project owner.
# The publishable key and URL are required for the app to initialize the Supabase client in `src/integrations/supabase/client.ts`.

# Frontend configuration
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
# URL pública do frontend
VITE_SITE_URL="http://localhost:5173"
# URL pública do backend Node
VITE_API_URL="http://localhost:4000"
# Exemplo para uso em rede local:
# VITE_SITE_URL=http://192.168.1.7:8080
# VITE_API_URL=http://192.168.1.7:4000
# Optional: override the backend base URL; defaults to VITE_API_URL or the current origin
VITE_API_BASE_URL="https://your-backend-domain.com/api"

# Backend Supabase credentials
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# Backend server configuration
BACKEND_PORT="4000"
LOG_LEVEL="info"
PUBLIC_BASE_URL="https://your-backend-domain.com"
ALLOWED_ORIGINS="https://your-frontend-domain.com"
ALLOWED_WEBHOOK_DOMAIN="your-backend-domain.com"
HEARTBEAT_INTERVAL_MS="60000"
HEARTBEAT_TOLERANCE_MS="600000"

# Daily.co configuration
DAILY_API_KEY=""
DAILY_PROJECT_URL="https://your-team.daily.co"

# Mercado Pago configuration
MERCADOPAGO_ACCESS_TOKEN=""
# Alias supported: MERCADO_PAGO_ACCESS_TOKEN
MERCADOPAGO_PUBLIC_KEY=""
MERCADOPAGO_WEBHOOK_SECRET=""
# Must match the canonical ${PUBLIC_BASE_URL}/api/payments/webhook
MERCADOPAGO_WEBHOOK_URL="https://your-backend-domain.com/api/payments/webhook"
MERCADOPAGO_CURRENCY="USD"

# Email / Resend configuration
RESEND_API_KEY=""
EMAIL_LOCALE="en-US"
